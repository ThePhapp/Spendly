# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files
.env*
.dev.vars
.dev.vars.*

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Local agent/tool state; never publish it.
/.agents/
/.codex/
/outputs/
/work/
